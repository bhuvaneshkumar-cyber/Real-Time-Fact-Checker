# Environment variables for Real-Time Fact Checker Backend
# Copy this file to .env and fill in the values

# Server settings are passed dynamically via Uvicorn CLI (or Docker)

# LLM provider selection: ollama, or nim
LLM_PROVIDER=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048

# NVIDIA NIM settings (OpenAI-compatible)
# Get your NIM API key from https://build.nvidia.com/
NIM_API_KEY=your_nim_api_key_here
NIM_MODEL=nemotron-3-8b-chat
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Tavily Search API settings (only used if USE_SEARCH=true)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=advanced

# Enable/disable search functionality
# Set to "true" to use external search (requires TAVILY_API_KEY)
# Set to "false" to rely solely on LLM knowledge (faster, good for real-time)
USE_SEARCH=false

# Extension ID (optional, for stricter CORS)
# EXTENSION_ID=your_chrome_extension_id_here

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# LLM performance tuning
# Max parallel LLM calls (lower = less GPU contention, higher = faster batch)
LLM_MAX_CONCURRENCY=2
# Token limits (keep low for fast responses)
LLM_EXTRACT_MAX_TOKENS=512
LLM_CLASSIFY_MAX_TOKENS=150
