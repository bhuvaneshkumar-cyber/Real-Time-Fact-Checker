# Copy to .env. Every value here is optional; these are the defaults.

# ollama (local) or nim (NVIDIA hosted)
LLM_PROVIDER=ollama

# Best accuracy/latency on a CPU-only laptop; re-run benchmark_models.py on other hardware
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_KEEP_ALIVE=30m

# NVIDIA NIM (https://build.nvidia.com/) — required only when LLM_PROVIDER=nim
# NIM_API_KEY=
# NIM_MODEL=meta/llama-3.1-8b-instruct

# Re-judge claims against DuckDuckGo results (more accurate, slower)
USE_SEARCH=false
SEARCH_MAX_RESULTS=3

REQUEST_TIMEOUT=60
LLM_MAX_TOKENS=400
